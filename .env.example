# ==============================================================================
# MCP SmartCache — Environment Configuration Reference
# ==============================================================================
# Copy this file to .env for local configuration.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Runtime Environment (production | development | test)
# When ENVIRONMENT=production:
# - Mock servers are STRICTLY EXCLUDED.
# - Production security validation mandates strong, non-default API keys.
ENVIRONMENT=production

# Enable development mock MCP servers (strictly for local development and test)
# Must be set to 'false' in production.
ENABLE_DEV_MOCKS=false

# Authentication Controls
# AUTH_ENABLED must be 'true' in production.
AUTH_ENABLED=true

# Master Administrative API Key (Minimum 16 characters; generate via openssl rand -hex 24)
# Required for: cache policy updates, manual invalidation, Prometheus metrics scraping.
# In production, must NOT start with 'dev-' or 'test-'.
GATEWAY_ADMIN_API_KEY=replace-with-a-secure-random-admin-key-min-16-chars

# Client API Key for tool execution and catalog discovery
# In single-tenant mode, bound to DEFAULT_CLIENT_TENANT.
GATEWAY_CLIENT_API_KEY=replace-with-a-secure-random-client-key-min-16-chars

# Default tenant ID bound to GATEWAY_CLIENT_API_KEY
DEFAULT_CLIENT_TENANT=default

# Multi-Tenant Client Key Mapping (Optional)
# Maps individual client API keys to authorized tenant IDs.
# Format: JSON mapping of {"<api_key>": "<tenant_id>"}
# Example: CLIENT_TENANT_KEYS={"key_tenant_alpha_secret_32char": "tenant-alpha", "key_tenant_beta_secret_32char": "tenant-beta"}
# CLIENT_TENANT_KEYS={}

# Redis Cache & Coordination URL
REDIS_URL=redis://localhost:6379/0

# PostgreSQL Durable Persistence Database URL
DATABASE_URL=postgresql+asyncpg://mcp_user:mcp_password@localhost:5432/mcp_smartcache

# Production Upstream Servers Configuration File Path (Optional)
# JSON file specifying real upstream MCP servers (command/args or SSE URLs).
# UPSTREAM_CONFIG_PATH=/etc/mcp-smartcache/upstream_servers.json

# Maximum Request Body Size in bytes (Default: 1048576 = 1 MB)
MAX_REQUEST_BYTES=1048576

# Allowed CORS Origins (Comma-separated list; leave empty to disallow cross-origin requests)
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=
