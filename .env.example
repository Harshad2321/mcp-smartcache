# MCP SmartCache Environment Configuration Template
# Copy this file to .env and supply environment-specific secrets before starting services.
# NEVER commit .env files containing real secrets to version control.

# ── Deployment Mode ────────────────────────────────────────────────────────────
ENVIRONMENT=production                 # 'development', 'test', or 'production'
ENABLE_DEV_MOCKS=false                 # Must be 'false' in production mode
AUTH_ENABLED=true                      # Must be 'true' in production mode

# ── Database & Cache Infrastructure ───────────────────────────────────────────
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=replace-with-a-secure-random-postgres-password
POSTGRES_DB=mcp_smartcache
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

REDIS_PASSWORD=replace-with-a-secure-random-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Gateway Authentication & Multi-Tenancy ─────────────────────────────────────
# Minimum 16 characters, must not use default or dev- prefixed keys in production
GATEWAY_ADMIN_API_KEY=replace-with-a-secure-random-admin-key-min-16-chars
GATEWAY_CLIENT_API_KEY=replace-with-a-secure-random-client-key-min-16-chars

# Comma-separated or JSON mapping client API keys to authorized tenant scopes:
# Format: <client_api_key_1>:<tenant_id_1>,<client_api_key_2>:<tenant_id_2>
CLIENT_TENANT_KEYS=client-key-alpha-min-16-chars:tenant_a,client-key-beta-min-16-chars:tenant_b
DEFAULT_CLIENT_TENANT=default

# ── Control Plane & Gateway Communication ──────────────────────────────────────
GATEWAY_MCP_URL=http://gateway:8000
CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://control-api.example.com
MAX_REQUEST_BYTES=10485760             # 10MB default request body size bound

# ── Enterprise Identity Provider (OAuth2 / OIDC) ──────────────────────────────
# Optional: enable for enterprise SSO (Okta, Auth0, Entra ID, Keycloak)
OIDC_ISSUER=https://auth.example.com/
OIDC_AUDIENCE=mcp-smartcache
OIDC_SIGNING_KEY=                      # Public key PEM for static verification, or leave empty if using JWKS
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_CLAIM=roles

# ── Distributed Quotas & Failure Policies ─────────────────────────────────────
# 'fail_closed' strictly rejects requests with HTTP 429 when Redis cluster is down.
# 'degrade_local' temporarily falls back to in-process memory tracking with alerts.
QUOTA_REDIS_FAILURE_POLICY=fail_closed
